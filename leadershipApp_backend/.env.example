# Database Connection (AsyncPG for FastAPI runtime, Psycopg2 for Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadership_app
SQL_ECHO=false

# Security & JWT Tokens
SECRET_KEY=leadership-app-development-secret-key-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM & OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
MAX_TOKENS=2048

# Vector Database (Qdrant)
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=knowledge_base

# Redis (Caching & Distributed Conversation Locks)
REDIS_URL=redis://localhost:6379/0

# Embeddings & Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=10
SIMILARITY_THRESHOLD=0.45

# Email / SMTP Settings (Optional, for password recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=10

